NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://annytrade.onrender.com
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_ANNYTRADE_URL=https://annytrade.onrender.com
ANNYTRADE_STANDALONE=1

# Supabase pooler (transaction mode). Prefer ANNYTRADE_DATABASE_URL in host env.
ANNYTRADE_DATABASE_URL=postgresql://annytrade_app.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require

ANNYTRADE_MARKET_DATA_PROVIDER=demo
ANNYTRADE_NEWS_PROVIDER=demo
ANNYTRADE_CALENDAR_PROVIDER=demo
# Optional Finnhub key — set provider to finnhub when key is present
ANNYTRADE_MARKET_DATA_API_KEY=

ANNYTRADE_BROKER_LIVE_ENABLED=false
ANNYTRADE_BROKER_LIVE_ORDERS_ENABLED=false
ANNYTRADE_ALLOW_LIVE_TRADING=false
ANNYTRADE_EMERGENCY_KILL_SWITCH=false
ANNYTRADE_BROKER_ORDERS_ENABLED=false

ANNYTRADE_RATE_LIMIT_BACKEND=memory
ANNYTRADE_RATE_LIMIT_FAIL_CLOSED=false

# When Resend is unset, return verify/reset links in API + notifications (paper desk)
ANNYTRADE_MAIL_FALLBACK_EXPOSE=1

# Optional — add your Resend key to send real mail
RESEND_API_KEY=
RESEND_FROM_EMAIL=AnnyTrade <onboarding@resend.dev>

ANNYTRADE_ADMIN_EMAILS=mercyanny2020@gmail.com
ANNYTRADE_CRON_SECRET=
CRON_SECRET=
ANNYTRADE_WEBHOOK_HMAC_SECRET=
ANNYTRADE_SENTRY_DSN=
