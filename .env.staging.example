# AnnyTrade staging environment — NEVER use production secrets here.

NODE_ENV=production
# Public site URL for CSRF Origin checks
NEXT_PUBLIC_APP_URL=https://staging.example.com
# Or whatever your env module reads for app URL

# Dedicated staging database (separate from production)
ANNYTRADE_DATABASE_URL=postgres://annytrade_staging:CHANGE_ME@localhost:5433/annytrade_staging

# Market data — demo OR a staging-only API key (not production)
ANNYTRADE_MARKET_DATA_PROVIDER=demo
ANNYTRADE_MARKET_DATA_API_KEY=

# Broker — Alpaca PAPER only
ANNYTRADE_BROKER_PROVIDER=alpaca_paper
ANNYTRADE_BROKER_API_KEY_ID=
ANNYTRADE_BROKER_API_SECRET_KEY=
ANNYTRADE_BROKER_ENCRYPTION_KEY=
ANNYTRADE_BROKER_ORDERS_ENABLED=false

# Live remains hard-blocked in code; keep flags off
ANNYTRADE_BROKER_LIVE_ENABLED=false
ANNYTRADE_BROKER_LIVE_ORDERS_ENABLED=false
ANNYTRADE_ALLOW_LIVE_TRADING=false
ANNYTRADE_EMERGENCY_KILL_SWITCH=false

# Admin bootstrap (staging emails only)
ANNYTRADE_ADMIN_EMAILS=

# Optional staging Redis / alerts / Sentry (staging DSN only)
ANNYTRADE_RATE_LIMIT_BACKEND=memory
ANNYTRADE_SENTRY_DSN=
ANNYTRADE_ALERT_WEBHOOK_URL=

# Set to 1 only for local HTTP staging / Playwright against http://127.0.0.1
# Never enable on public HTTPS production.
# ANNYTRADE_COOKIE_INSECURE=1
